---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only; localStorage is never touched at build time.
  import {
    STORAGE_KEY,
    SEPARATOR,
    parseStored,
    addBookmark,
    type Bookmark,
  } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const empty = document.getElementById('empty-state');
  const header = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');
  const hint = document.querySelector('.hint');

  let bookmarks: Bookmark[] = [];

  function load(): Bookmark[] {
    try {
      return parseStored(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function save(): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      // Storage unavailable or full: keep working in memory.
    }
  }

  function message(text: string): void {
    if (hint) hint.textContent = text;
  }

  async function copy(text: string, button: HTMLButtonElement): Promise<void> {
    try {
      await navigator.clipboard.writeText(text);
      button.textContent = 'Copied!';
    } catch {
      button.textContent = 'Copy failed';
    }
    setTimeout(() => (button.textContent = 'Copy'), 1500);
  }

  function render(): void {
    if (!list) return;
    list.replaceChildren();
    for (const b of bookmarks) {
      const li = document.createElement('li');
      li.className = 'bookmark';

      const text = document.createElement('span');
      text.className = 'text';

      const a = document.createElement('a');
      a.className = 'url';
      a.href = b.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = b.url;

      const sep = document.createElement('span');
      sep.className = 'sep';
      sep.textContent = SEPARATOR;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = b.slug;

      text.append(a, sep, slug);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy';
      btn.textContent = 'Copy';
      btn.setAttribute('aria-label', `Copy ${b.slug}`);
      btn.addEventListener('click', () => void copy(b.slug, btn));

      li.append(text, btn);
      list.append(li);
    }
    const has = bookmarks.length > 0;
    if (empty) empty.hidden = has;
    if (header) header.hidden = !has;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // first statement: never let a native submit reload the page
    try {
      const result = addBookmark(bookmarks, input?.value);
      if (!result.added) {
        message('That doesn’t look like a valid link — try something like example.com.');
        input?.focus();
        return;
      }
      bookmarks = result.list;
      save();
      render();
      message('Saved! Paste another URL to add more.');
      if (input) input.value = '';
      input?.focus();
    } catch {
      message('Something went wrong saving that link. Please try again.');
    }
  });

  clearAll?.addEventListener('click', () => {
    try {
      if (!confirm('Remove all saved bookmarks?')) return;
      bookmarks = [];
      try {
        localStorage.removeItem(STORAGE_KEY);
      } catch {
        // ignore
      }
      render();
    } catch {
      // ignore
    }
  });

  bookmarks = load();
  render();
</script>

<style is:global>
  #add-bookmark button[type='submit'] {
    box-shadow: 0 1px 2px #0003;
    transition: transform 0.1s, filter 0.15s;
  }
  #add-bookmark button[type='submit']:active { transform: translateY(1px); }
  #add-bookmark input:focus { border-color: var(--accent); }
  li.bookmark {
    justify-content: space-between;
    background: color-mix(in srgb, var(--accent) 4%, transparent);
    box-shadow: 0 1px 3px #0001;
    transition: border-color 0.15s, transform 0.15s;
  }
  li.bookmark:hover { border-color: var(--accent); transform: translateY(-1px); }
  .bookmark .text { flex: 1 1 14rem; min-width: 0; overflow-wrap: anywhere; }
  .bookmark .url { color: var(--accent); text-decoration: none; font-weight: 600; }
  .bookmark .url:hover { text-decoration: underline; }
  .bookmark .sep { white-space: pre; color: var(--muted); }
  .bookmark .slug { font-family: var(--font-body); font-weight: 600; display: inline-block; }
  .bookmark .copy:hover { border-color: var(--accent); }
</style>
